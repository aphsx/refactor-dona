# Server-only: Next.js proxies /api/v1/* to this origin.
DONA_API_URL=http://127.0.0.1:8080

# Optional listen port
PORT=3000

# Server-only: Storage uploads
# - plot-previews (public) — plot preview images
# - announcement-images (public) — LINE announcement images
# - avatars (public, 100KB) — profile photos
# - loan-documents (public, 8MB) — loan application documents
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# production example:
# NODE_ENV=production
# DONA_API_URL=https://api.example.com
# PORT=3000
