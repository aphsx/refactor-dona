# Server-only: Next.js proxies /api/v1/* to this origin.
DONA_API_URL=http://127.0.0.1:8080

# Optional listen port
PORT=3000

# Server-only: plot preview upload → Supabase Storage (public bucket `plot-previews`)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# production example:
# NODE_ENV=production
# DONA_API_URL=https://api.example.com
# PORT=3000
